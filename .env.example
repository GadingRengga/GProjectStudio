# Supabase client values — the URL and anon key are public by design (safe in browser bundles).
# NEVER put third-party secrets (email API keys, payment gateway keys) in VITE_* vars.
# Those live only in Supabase Edge Functions via `supabase secrets set` (docs/EDGE-FUNCTIONS-OPS.md).
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_APP_NAME=ERP App
VITE_APP_VERSION=0.1.0
